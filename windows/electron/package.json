{
  "name": "claude-code-widget-windows",
  "version": "1.0.0",
  "description": "Claude Code desktop widget — Windows",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:frontend": "npm --prefix ../../app install && npm --prefix ../../app run build",
    "build": "npm run build:frontend && electron-builder",
    "pack": "npm run build:frontend && electron-builder --dir"
  },
  "dependencies": {
    "pngjs": "^7.0.0"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "ai.anthropic.claude-code-widget",
    "productName": "Claude Code Widget",
    "extraResources": [
      { "from": "../../app/dist", "to": "dist", "filter": ["**/*"] },
      { "from": "get-auth.py", "to": "get-auth.py" }
    ],
    "win": {
      "target": ["nsis"],
      "icon": "../../app/logo.png"
    }
  }
}
